{
  "name": "echo-app",
  "private": true,
  "version": "0.2.5",
  "description": "Echo AI 音乐伴侣",
  "author": "Echo",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "node scripts/rebuild-native.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "dist": "npm run verify && electron-builder --win nsis",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "node scripts/run-vitest.mjs run --config vitest.config.ts --passWithNoTests",
    "test:watch": "node scripts/run-vitest.mjs --config vitest.config.ts",
    "test:e2e:electron": "node scripts/run-electron-e2e.mjs",
    "test:installer": "node scripts/run-installer-smoke.mjs",
    "verify": "npm run lint && npm test && npm run build && npm run test:e2e:electron",
    "release:verify": "npm run dist && npm run test:installer",
    "preview": "vite preview"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "4.32.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "node-cron": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.2",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "electron": "^35.7.5",
    "electron-builder": "^26.9.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "app.echo.desktop",
    "productName": "Echo",
    "artifactName": "Echo-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "extraResources": [
      {
        "from": "public/brand",
        "to": "brand",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../samples",
        "to": "samples",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/build/Release/*.node"
    ],
    "npmRebuild": true,
    "win": {
      "target": "nsis",
      "icon": "public/brand/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "public/brand/icon.ico",
      "uninstallerIcon": "public/brand/icon.ico",
      "installerHeaderIcon": "public/brand/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Echo",
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "unicode": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Echo",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  }
}
